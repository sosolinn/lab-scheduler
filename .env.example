# Supabase PostgreSQL URL connection
# 在 Supabase Dashboard 顶部点击 Connect，复制 Connection string
# 请把真实连接信息填写到本地 .env.local，不要提交真实密码到 GitHub

# 应用运行连接：推荐使用 Supavisor Transaction pooler（通常端口为 6543）
DATABASE_URL="postgresql://postgres.PROJECT_REF:DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"

# 数据库迁移或需要长期连接时使用：Direct connection（通常端口为 5432）
# Direct connection 默认需要 IPv6 网络；IPv4 环境可改用 Session pooler
DIRECT_URL="postgresql://postgres:DATABASE_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"
