# Supabase PostgreSQL URL connection
# 在 Supabase Dashboard 顶部点击 Connect，复制 Connection string。
# 真实密码只填写到本地 .env.local 或部署平台，不要提交到 GitHub。

# 应用运行连接：推荐 Supavisor Transaction pooler（通常端口 6543）
DATABASE_URL="postgresql://postgres.PROJECT_REF:DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"

# 数据库迁移或长期连接时使用，可选
DIRECT_URL="postgresql://postgres:DATABASE_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# 首个本地管理员
# 系统仅在数据库中尚无管理员时读取以下变量并创建首个管理员。
LAB_BOOTSTRAP_ADMIN_USERNAME="admin"
LAB_BOOTSTRAP_ADMIN_PASSWORD="请替换为至少8位的强密码"
LAB_BOOTSTRAP_ADMIN_DISPLAY_NAME="实验室管理员"

# 值日日期判定时区
LAB_TIME_ZONE="Asia/Shanghai"
